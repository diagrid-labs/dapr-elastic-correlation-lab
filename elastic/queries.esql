-- Verified against the lab data. Edit the index patterns to match the target
-- cluster: with the APM integration traces land in traces-apm-* rather than
-- traces-generic-default.

-- One service across all three signals, from three data streams written by two
-- different collectors.
--
-- The ::keyword casts are needed: app_id is mapped as keyword in the metrics
-- stream and text in the logs stream, and ES|QL refuses the ambiguity without
-- them. METADATA _index is required too, or _index is an unknown column.
FROM logs-*, traces-*, metrics-* METADATA _index
| EVAL service = COALESCE(attributes.app_id::keyword,
                          resource.attributes.service.name::keyword)
| EVAL signal = CASE(STARTS_WITH(_index, ".ds-logs"), "logs",
                     STARTS_WITH(_index, ".ds-traces"), "traces", "metrics")
| WHERE service == "logtest"
| STATS docs = COUNT(*) BY signal
| SORT signal;


-- Dapr API call volume by status code.
FROM logs-*
| WHERE attributes.msg == "HTTP API Called"
| STATS calls = COUNT(*) BY ts = BUCKET(@timestamp, 1 minute), code = attributes.code
| SORT ts;

-- 5xx ratio across all Dapr API calls.
FROM logs-*
| WHERE attributes.msg == "HTTP API Called"
| STATS total = COUNT(*), errors = COUNT(CASE(attributes.code >= 500, 1, null))
| EVAL error_pct = ROUND(100.0 * errors / total, 2)
| KEEP error_pct;

-- p95 latency per Dapr API, from the trace side. Span duration is nanoseconds.
FROM traces-*
| STATS p95_ms = ROUND(PERCENTILE(duration, 95)/1000000.0, 3) BY api = attributes.dapr.api
| SORT p95_ms DESC;

-- Control plane log volume. The blank scope rows are real: the scheduler's
-- embedded cron library logs under `logger` instead of `scope`.
FROM logs-*
| WHERE resource.attributes.k8s.namespace.name == "dapr-system"
| STATS lines = COUNT(*) BY scope = attributes.scope, log.level = attributes.level
| SORT lines DESC;

-- The join. Spans and access log lines line up on service, API and status.
-- service.name on the span resource attributes is the Dapr app_id.
FROM traces-*
| KEEP @timestamp, trace_id, resource.attributes.service.name,
       attributes.dapr.api, attributes.dapr.status_code, duration
| SORT @timestamp DESC
| LIMIT 20;

-- Metrics join to the log side on attributes.app_id, NOT on service.name:
-- resource.attributes.service.name is "daprd" on a metric because it names the
-- scrape target, while on a span it is the Dapr app id.
FROM metrics-*
| WHERE attributes.app_id IS NOT NULL
| KEEP @timestamp, attributes.app_id, resource.attributes.service.name
| LIMIT 10;

-- The join. Each API appears twice, once from the logs and once from the
-- traces, with matching status.
FROM logs-*, traces-* METADATA _index
| EVAL service = COALESCE(attributes.app_id::keyword,
                          resource.attributes.service.name::keyword)
| EVAL api     = COALESCE(attributes.method::keyword,
                          attributes.dapr.api::keyword)
| EVAL status  = COALESCE(attributes.code::keyword,
                          attributes.dapr.status_code::keyword)
| EVAL signal  = CASE(STARTS_WITH(_index, ".ds-logs"), "log", "span")
| WHERE service == "logtest" AND api IS NOT NULL
| STATS count = COUNT(*) BY api, signal, status
| SORT api, signal;
